# ============================================
# DATABASE (Vercel Postgres or Supabase)
# ============================================
POSTGRES_URL="postgres://username:password@host:5432/database"
POSTGRES_PRISMA_URL="postgres://username:password@host:5432/database?pgbouncer=true"
POSTGRES_URL_NON_POOLING="postgres://username:password@host:5432/database"

# ============================================
# REDIS (Upstash Redis - Free Tier)
# ============================================
UPSTASH_REDIS_URL="https://your-redis-url.upstash.io"
UPSTASH_REDIS_TOKEN="your-redis-token"

# ============================================
# AI APIs (Приоритет сверху вниз для fallback)
# ============================================

# 1. Perplexity API (РЕКОМЕНДУЕТСЯ для Deep Research)
# Pro users: $5/month credit | Free tier: limited
# https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY="pplx-xxxxxxxxxxxxxxxxxxxxxxxx"

# 2. Anthropic Claude (для стратегии и промптов)
# Free tier: $5 credit | Sonnet 3.5 рекомендуется
# https://console.anthropic.com/
ANTHROPIC_API_KEY="sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx"

# 3. Google Gemini (бесплатный tier с хорошим лимитом)
# Free tier: 1500 requests/day | Gemini 1.5 Flash бесплатно
# https://makersuite.google.com/app/apikey
GOOGLE_GEMINI_API_KEY="AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# 4. OpenRouter (доступ к множеству моделей через один API)
# Free tier: некоторые модели бесплатны
# https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-xxxxxxxxxxxxxxxxxxxxxxxx"

# 5. OpenAI (платный, но качественный)
# Платный API | GPT-4o mini дешевле
# https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-xxxxxxxxxxxxxxxxxxxxxxxx"

# 6. Groq (ОЧЕНЬ БЫСТРЫЙ, бесплатный tier)
# Free tier: 14400 requests/day | Llama 3, Mixtral бесплатно
# https://console.groq.com/keys
GROQ_API_KEY="gsk_xxxxxxxxxxxxxxxxxxxxxxxx"

# 7. Together AI (бесплатный tier для open-source моделей)
# Free tier: $25 credit при регистрации
# https://api.together.xyz/settings/api-keys
TOGETHER_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxx"

# 8. Mistral AI (бесплатный tier)
# Free tier: ограниченный доступ к Mistral моделям
# https://console.mistral.ai/api-keys/
MISTRAL_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxx"

# ============================================
# SCRAPING
# ============================================
# Reddit API (https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID="your-client-id"
REDDIT_CLIENT_SECRET="your-client-secret"
REDDIT_USER_AGENT="YourApp/1.0.0"

# Twitter API v2 (https://developer.twitter.com/)
TWITTER_BEARER_TOKEN="your-bearer-token"

# ============================================
# SECURITY
# ============================================
# Секрет для Vercel Cron Jobs (сгенерируйте случайную строку)
CRON_SECRET="your-random-secret-string"

# NextAuth (если будет аутентификация)
NEXTAUTH_SECRET="your-nextauth-secret"
NEXTAUTH_URL="http://localhost:3000"

# ============================================
# UPSTASH QSTASH (для очередей задач)
# ============================================
QSTASH_URL="https://qstash.upstash.io"
QSTASH_TOKEN="your-qstash-token"

# ============================================
# NODE ENVIRONMENT
# ============================================
NODE_ENV="development"
